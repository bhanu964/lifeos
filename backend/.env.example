# ==============================================================================
# LifeOS Backend (.env.example)
# ==============================================================================

# Core Application Settings
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=https://api.your-lifeos-domain.com
CORS_ALLOWED_ORIGINS=https://lifeos.vercel.app,http://localhost:5173

# Security & Multi-Tenant Encryption
# Generate JWT_SECRET_KEY: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_secure_random_64_char_hex_key_in_production
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change_this_to_a_valid_fernet_base64_key_in_production
DATABASE_URL=sqlite:///data/lifeos_saas.db

# Telegram Bot Integration (BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_CHAT_ID=your_default_telegram_chat_id

# Qdrant Cloud Vector Database (Persistent Semantic Memory)
QDRANT_URL=https://your-cluster-id.eu-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=agentmemory_memories

# Lyzr Agent API & Multi-Agent Triad
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_API_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_TOOL_EXECUTE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/tools/execute
LYZR_MANAGER_AGENT_ID=your_lyzr_manager_agent_id
LYZR_FACT_FINDER_AGENT_ID=your_lyzr_fact_finder_agent_id
LYZR_DATA_ANALYST_AGENT_ID=your_lyzr_data_analyst_agent_id
LYZR_USER_ID=user@example.com

# Composio Integration Credentials (Optional Server-level Defaults)
GOOGLE_CALENDAR_CREDENTIAL_ID=your_google_calendar_credential_id
GOOGLE_CALENDAR_PROVIDER_UUID=your_google_calendar_provider_uuid
GOOGLE_TASKS_CREDENTIAL_ID=your_google_tasks_credential_id
GOOGLE_TASKS_PROVIDER_UUID=your_google_tasks_provider_uuid
GMAIL_CREDENTIAL_ID=your_gmail_credential_id
GMAIL_PROVIDER_UUID=your_gmail_provider_uuid
TELEGRAM_CREDENTIAL_ID=your_telegram_credential_id
TELEGRAM_PROVIDER_UUID=your_telegram_provider_uuid

# Omi Voice & Webhook Configuration
OMI_API_KEY=your_omi_api_key_here
